<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_view_platform_title"
            style="@style/TextAppearance.MaterialComponents.Headline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:text="Configuración de Plataforma (P1)" />

        <!-- Card para Temporizadores -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temporizadores"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_input_layout_timer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Valor del Temporizador (D130)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_timer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/button_save_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/save_button" />

                <!-- Timer 2 (solo para P2) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_input_layout_timer2"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Desfase sacar uña - D131"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_timer2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/button_save_timer2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="@string/save_button"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card para el Número de Serie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_serial_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_input_layout_serial_number"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de Serie (D2120-D2122)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_serial_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="5" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Formato: 9 dígitos → 2100XXXXX"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <Button
                    android:id="@+id/button_save_serial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="Guardar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card para los Contadores -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/TextAppearance.MaterialComponents.Subtitle1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contadores"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/text_view_counter1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-"/>
                    <Button android:id="@+id/button_reset_counter1" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/text_view_counter2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-"/>
                    <Button android:id="@+id/button_reset_counter2" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/text_view_counter3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-"/>
                    <Button android:id="@+id/button_reset_counter3" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <!-- Contador 4 (solo para P2) -->
                <LinearLayout
                    android:id="@+id/counter4_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/text_view_counter4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Contador 4: -"/>
                    <Button android:id="@+id/button_reset_counter4" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <!-- Contador 5 (solo para P2) -->
                <LinearLayout
                    android:id="@+id/counter5_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/text_view_counter5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Contador 5: -"/>
                    <Button android:id="@+id/button_reset_counter5" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:id="@+id/switches_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Los switches se añadirán aquí, pero los definimos para tener IDs -->
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch1" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 1" android:visibility="gone" tools:visibility="visible"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch2" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 2" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch3" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 3" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch4" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 4" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch5" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 5" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch6" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 6" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch7" android:layout_width="match_parent" android:layout_height="wrap_content" tools:text="Opción 7" android:visibility="gone" tools:visibility="visible" android:layout_marginTop="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/button_save_platform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/save_button" />

    </LinearLayout>
</ScrollView>