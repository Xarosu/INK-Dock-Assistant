<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Mensaje de advertencia para modo ESP32 -->
    <TextView
        android:id="@+id/text_view_esp32_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/esp32_not_available_door"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"/>

    <!-- Contenido normal de la puerta -->
    <ScrollView
        android:id="@+id/scroll_view_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            style="@style/TextAppearance.MaterialComponents.Headline5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de la Puerta Seccional"
            android:layout_marginBottom="16dp"/>

        <!-- Card para el Temporizador -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_input_layout_timer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/door_timer_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_timer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/button_save_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="Guardar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card para el Número de Serie -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_serial_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/text_input_layout_serial_number"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Número de Serie (D2110-D2112)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_serial_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="12" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Formato: 9 dígitos → 2100XXXXX"
                    android:textAppearance="?attr/textAppearanceCaption" />

                <Button
                    android:id="@+id/button_save_serial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:text="Guardar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card para los Contadores -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/TextAppearance.MaterialComponents.Subtitle1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contadores"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <TextView android:id="@+id/text_view_counter1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Contador 1 (D122): -"/>
                    <Button android:id="@+id/button_reset_counter1" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/text_view_counter2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Contador 2 (D123): -"/>
                    <Button android:id="@+id/button_reset_counter2" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <TextView android:id="@+id/text_view_counter3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Contador 3 (D124): -"/>
                    <Button android:id="@+id/button_reset_counter3" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reset_button"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card para los Switches -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/switches_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/TextAppearance.MaterialComponents.Subtitle1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opciones" android:layout_marginBottom="8dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/door_switch_1"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/door_switch_2" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/door_switch_3" android:layout_marginTop="8dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/door_switch_4" android:layout_marginTop="8dp"/>

                <Button
                    android:id="@+id/button_save_switches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="16dp"
                    android:text="Guardar Opciones" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>

</FrameLayout>